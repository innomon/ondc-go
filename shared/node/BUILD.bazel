load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "node",
    srcs = [
        "config.go",
        "router.go",
        "server.go",
    ],
    importpath = "ondc/shared/node",
    visibility = ["//visibility:public"],
    deps = [
        "//shared/p2p",
        "//shared/storage",
        "@com_github_google_uuid//:uuid",
        "@org_golang_x_crypto//acme/autocert",
        "@org_modernc_sqlite//:sqlite",
    ],
)

go_test(
    name = "node_test",
    srcs = [
        "config_test.go",
        "router_test.go",
        "server_test.go",
    ],
    deps = [
        ":node",
        "//shared/storage",
        "@org_modernc_sqlite//:sqlite",
    ],
)
